---
import { postSummary } from "@/lib/post-view";
import type { Post } from "@/lib/posts";

type Props = {
  post: Post;
};

const { post } = Astro.props;
const { url, minutes, dateStr } = postSummary(post);
---

<article class="post-card">
  <a href={url} class="post-card__link">
    <span class="post-card__serial" aria-hidden="true">Opinion</span>
    <div class="post-card__body">
      <header class="post-card__head">
        <time class="post-card__date" datetime={post.data.date.toISOString()}>
          {dateStr}
        </time>
        {post.data.tags.length > 0 && (
          <>
            <span class="post-card__head-divider" aria-hidden="true"></span>
            <ul class="post-card__tags" aria-label="标签">
              {post.data.tags.slice(0, 3).map((tag) => (
                <li>#{tag}</li>
              ))}
            </ul>
          </>
        )}
      </header>
      <h2 class="post-card__title">{post.data.title}</h2>
      {post.data.subtitle && (
        <p class="post-card__subtitle">{post.data.subtitle}</p>
      )}
      <p class="post-card__excerpt">{post.data.description}</p>
      <p class="post-card__meta">
        <span class="post-card__author">J</span>
        <span>{minutes} 分钟</span>
        <span class="post-card__head-divider" aria-hidden="true"></span>
        <span class="post-card__cta">阅读全文</span>
      </p>
    </div>
  </a>
</article>
