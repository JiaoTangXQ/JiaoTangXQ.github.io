---
import type { MarkdownHeading } from "astro";

type Props = {
  // 调用方需传入已经清洗过的 h2/h3 列表（PostView.headings）。
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;
---

{
  headings.length >= 2 && (
    <aside class="article-toc" aria-label="目录">
      <p class="article-toc__label">目录</p>
      <ol class="article-toc__list">
        {headings.map((h) => (
          <li class:list={["article-toc__item", `article-toc__item--d${h.depth}`]}>
            <a href={`#${h.slug}`} class="article-toc__link" data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )
}

<script is:inline>
  (function () {
    var links = document.querySelectorAll("[data-toc-link]");
    if (!links.length) return;

    var linkMap = new Map();
    links.forEach(function (a) {
      linkMap.set(a.getAttribute("data-toc-link"), a);
    });

    var headings = document.querySelectorAll(".prose h2[id], .prose h3[id]");
    if (!headings.length) return;

    var visible = new Set();

    function setCurrent(slug) {
      links.forEach(function (l) {
        l.classList.remove("is-current");
      });
      var link = linkMap.get(slug);
      if (link) link.classList.add("is-current");
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            visible.add(entry.target.id);
          } else {
            visible.delete(entry.target.id);
          }
        });
        var current = null;
        headings.forEach(function (h) {
          if (!current && visible.has(h.id)) current = h.id;
        });
        if (current) setCurrent(current);
      },
      { rootMargin: "-15% 0px -65% 0px", threshold: 0 },
    );

    headings.forEach(function (h) {
      observer.observe(h);
    });
  })();
</script>
