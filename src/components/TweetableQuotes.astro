---
// 给 .prose 里的 blockquote 自动加 "Tweet" 分享按钮。
// 仅在文章页挂载。
---

<script is:inline>
  (function () {
    var quotes = document.querySelectorAll(".prose blockquote");
    if (!quotes.length) return;

    var pageUrl = location.origin + location.pathname;
    var pageTitle = document.title.split(" — ")[0];

    function buildIntentUrl(text) {
      var maxLen = 200; // 留 80 字给 URL + 引号 + 作者名
      var quoted = text.replace(/\s+/g, " ").trim();
      if (quoted.length > maxLen) {
        quoted = quoted.slice(0, maxLen - 1) + "…";
      }
      var body = "「" + quoted + "」\n— " + pageTitle;
      var u = new URL("https://x.com/intent/post");
      u.searchParams.set("text", body);
      u.searchParams.set("url", pageUrl);
      u.searchParams.set("via", "leadbelief");
      return u.toString();
    }

    quotes.forEach(function (q) {
      // 跳过含已有按钮 / 嵌套 quote 的情况
      if (q.querySelector("[data-tweet-btn]")) return;
      if (q.closest("[data-no-tweet]")) return;

      var btn = document.createElement("button");
      btn.type = "button";
      btn.setAttribute("data-tweet-btn", "");
      btn.setAttribute("aria-label", "在 X 分享这段引用");
      btn.title = "在 X 分享这段引用";
      btn.innerHTML =
        '<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12.6 1.6h2.3l-5 5.7L16 15.4h-4.6l-3.6-4.7-4.1 4.7H1.4l5.3-6.1L1 1.6h4.7l3.3 4.4 3.6-4.4Zm-.8 12.4h1.3L4.3 3H2.9l8.9 11Z"/></svg>';
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        var text = q.innerText || q.textContent || "";
        window.open(buildIntentUrl(text), "tweet-popup", "width=550,height=420");
      });

      q.style.position = "relative";
      q.appendChild(btn);
    });
  })();
</script>

<style is:global>
  .prose blockquote [data-tweet-btn] {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-paper);
    color: var(--color-ink-muted);
    border: 1px solid var(--color-rule-soft);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .prose blockquote:hover [data-tweet-btn],
  .prose blockquote:focus-within [data-tweet-btn],
  .prose blockquote [data-tweet-btn]:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .prose blockquote [data-tweet-btn]:hover {
    color: var(--color-accent-deep);
    border-color: var(--color-accent);
  }
</style>
