---
import { dailyDay, dailyUrl, groupDailiesByMonth, type Daily } from "@/lib/dailies";

type Props = {
  dailies: Daily[];
  currentId?: string;
};

const { dailies, currentId } = Astro.props;
const groups = groupDailiesByMonth(dailies);
---

<aside class="daily-nav cp-cut" aria-label="日报导航">
  <p class="daily-nav__search">Briefing Index <span>Daily</span></p>
  <nav>
    {groups.map((group) => (
      <details open>
        <summary>{group.month.replace("-", " ")}</summary>
        <ul>
          {group.dailies.map((daily) => (
            <li>
              <a class:list={[{ "is-current": daily.id === currentId }]} href={dailyUrl(daily)}>
                <span>{dailyDay(daily).slice(5)}</span>
                AI 简报
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </nav>
</aside>

<button class="daily-nav-toggle" type="button" data-daily-nav-toggle>简报索引</button>
<div class="daily-nav-mobile" data-daily-nav-mobile hidden>
  <button type="button" data-daily-nav-close>关闭</button>
  <aside class="daily-nav cp-cut" aria-label="移动日报导航">
    <p class="daily-nav__search">Briefing Index <span>Daily</span></p>
    <nav>
      {groups.map((group) => (
        <details open>
          <summary>{group.month.replace("-", " ")}</summary>
          <ul>
            {group.dailies.map((daily) => (
              <li>
                <a class:list={[{ "is-current": daily.id === currentId }]} href={dailyUrl(daily)}>
                  <span>{dailyDay(daily).slice(5)}</span>
                  AI 简报
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </nav>
  </aside>
</div>

<script is:inline>
  (function () {
    var open = document.querySelector("[data-daily-nav-toggle]");
    var close = document.querySelector("[data-daily-nav-close]");
    var panel = document.querySelector("[data-daily-nav-mobile]");
    if (!open || !panel) return;
    open.addEventListener("click", function () { panel.removeAttribute("hidden"); });
    if (close) close.addEventListener("click", function () { panel.setAttribute("hidden", ""); });
  })();
</script>
