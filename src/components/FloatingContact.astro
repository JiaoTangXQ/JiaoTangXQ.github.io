<div class="floating-contact" data-floating-contact>
  <div class="floating-contact__panel" data-floating-contact-panel hidden>
    <button class="floating-contact__close" type="button" data-floating-contact-close aria-label="关闭">×</button>
    <p class="floating-contact__eyebrow">Contact</p>
    <h2>保持连接</h2>
    <a href="https://x.com/leadbelief" rel="me">X · @leadbelief</a>
    <a href="https://github.com/JiaoTangXQ" rel="me">GitHub · JiaoTangXQ</a>
    <a href="/rss.xml">RSS</a>
    <a href="/about/">关于焦糖</a>
  </div>
  <button class="floating-contact__toggle" type="button" data-floating-contact-toggle title="和我聊聊" aria-label="打开联系面板">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.4 15.4L2.8 21l3.8-.9A10 10 0 1 0 12 2Zm1.1 5 .8 1.8 1.9.8-1.9.8-.8 1.8-.8-1.8-1.9-.8 1.9-.8.8-1.8Zm-4 5 .9 2 2 .9-2 .9-.9 2-.9-2-2-.9 2-.9.9-2Z" />
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-floating-contact]");
    if (!root) return;
    var toggle = root.querySelector("[data-floating-contact-toggle]");
    var panel = root.querySelector("[data-floating-contact-panel]");
    var close = root.querySelector("[data-floating-contact-close]");
    function setOpen(open) {
      if (!panel || !toggle) return;
      if (open) {
        panel.removeAttribute("hidden");
        toggle.setAttribute("aria-label", "关闭联系面板");
      } else {
        panel.setAttribute("hidden", "");
        toggle.setAttribute("aria-label", "打开联系面板");
      }
    }
    if (toggle) {
      toggle.addEventListener("click", function () {
        setOpen(panel ? panel.hasAttribute("hidden") : false);
      });
    }
    if (close) close.addEventListener("click", function () { setOpen(false); });
  })();
</script>
