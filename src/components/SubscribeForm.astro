---
type Props = {
  variant?: "block" | "inline";
  title?: string;
  lede?: string;
};

const { variant = "block", title, lede } = Astro.props;

const username = (import.meta.env.PUBLIC_BUTTONDOWN_USERNAME as string | undefined)?.trim();
const action = username
  ? `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(username)}`
  : null;
const popup = username ? `https://buttondown.com/${encodeURIComponent(username)}` : null;

const headline = title ?? "把下一份 AI 情报送到你的邮箱";
const ledeText =
  lede ??
  "面向 AI 决策者与工程师的中文情报站。只推送重要更新，不发低价值噪音。";
---

<aside class:list={["subscribe", `subscribe--${variant}`]}>
  <p class="subscribe__eyebrow">订阅</p>
  <h2 class="subscribe__title">{headline}</h2>
  <p class="subscribe__lede">{ledeText}</p>
  {action && popup ? (
    <form
      class="subscribe__form"
      action={action}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('${popup}', 'popupwindow'); return true;`}
    >
      <label class="subscribe__label" for={`subscribe-email-${variant}`}>邮箱</label>
      <div class="subscribe__row">
        <input
          class="subscribe__input"
          type="email"
          name="email"
          id={`subscribe-email-${variant}`}
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button class="subscribe__btn" type="submit">订阅</button>
      </div>
      <p class="subscribe__alt">
        不爱邮件？订阅 <a href="/rss.xml">RSS</a> 或在 X 关注 <a href="https://x.com/leadbelief" rel="me">@leadbelief</a>。
      </p>
    </form>
  ) : (
    <p class="subscribe__placeholder">
      邮件订阅尚未启用。当前你可以订阅 <a href="/rss.xml">RSS</a>，或在 X 关注 <a href="https://x.com/leadbelief" rel="me">@leadbelief</a>，重要更新会同步发出。
    </p>
  )}
</aside>
