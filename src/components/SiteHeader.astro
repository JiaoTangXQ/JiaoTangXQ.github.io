---
type Current = "home" | "graph" | "about";
type Props = {
  current?: Current;
};

const { current = "home" } = Astro.props;
const links: Array<{ href: string; label: string; current: Current }> = [
  { href: "/", label: "文章", current: "home" },
  { href: "/graph/", label: "图谱", current: "graph" },
  { href: "/about/", label: "关于", current: "about" },
];
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label="返回首页">
    <span>焦糖星球</span>
    <small>personal notes</small>
  </a>
  <nav class="site-nav" aria-label="主导航">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={{ "is-current": current === link.current }}
        aria-current={current === link.current ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
    <button type="button" data-search-trigger aria-label="搜索文章">搜索</button>
    <button type="button" data-theme-toggle aria-label="切换主题">◐</button>
  </nav>
</header>

<script is:inline>
  (function () {
    var button = document.querySelector("[data-theme-toggle]");
    if (!button) return;
    button.addEventListener("click", function () {
      var current = document.documentElement.dataset.theme || "light";
      var next = current === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (_) {}
    });
  })();
</script>
