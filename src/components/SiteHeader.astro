---
type Props = {
  current?: "home" | "weekly" | "docs" | "about" | "rss";
};
const { current = "home" } = Astro.props;

const primaryLinks: Array<{ href: string; label: string; current: NonNullable<Props["current"]> }> = [
  { href: "/docs/", label: "AI 日报", current: "docs" },
  { href: "/weekly/", label: "AI 周报", current: "weekly" },
];
const secondaryLinks: Array<{ href: string; label: string; current: NonNullable<Props["current"]> }> = [
  { href: "/about/", label: "关于", current: "about" },
];
const links = [...primaryLinks, ...secondaryLinks];

const searchEnabled = true;
const isCurrentLink = (link: (typeof links)[number]) => Boolean(link.current && current === link.current);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="返回首页">
      <span class="site-header__brand-mark">焦糖星球</span>
      <span class="site-header__brand-edition" aria-hidden="true">The AI Gazette</span>
    </a>
    <nav class="site-header__nav" aria-label="主导航">
      {primaryLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "site-header__link",
            { "site-header__link--current": isCurrentLink(link) },
          ]}
          aria-current={isCurrentLink(link) ? "page" : undefined}
          data-header-link={link.current}
        >
          {link.label}
        </a>
      ))}
      {searchEnabled && (
        <button
          type="button"
          class="site-header__link site-header__search"
          data-search-trigger
          aria-label="打开搜索"
        >
          搜索
        </button>
      )}
      {secondaryLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "site-header__link",
            { "site-header__link--current": isCurrentLink(link) },
          ]}
          aria-current={isCurrentLink(link) ? "page" : undefined}
          data-header-link={link.current}
        >
          {link.label}
        </a>
      ))}
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="切换主题"
        title="切换深色 / 浅色主题"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M13.5 9.5A6 6 0 1 1 6.5 2.5a4.8 4.8 0 0 0 7 7Z" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="8" cy="8" r="3" />
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" />
        </svg>
      </button>
      <button class="mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-label="打开导航">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>
  <div class="mobile-menu" data-mobile-menu hidden>
    {primaryLinks.map((link) => (
      <a
        href={link.href}
        class:list={[{ "site-header__link--current": isCurrentLink(link) }]}
        aria-current={isCurrentLink(link) ? "page" : undefined}
        data-header-link={link.current}
      >
        {link.label}
      </a>
    ))}
    <button type="button" data-search-trigger>搜索</button>
    {secondaryLinks.map((link) => (
      <a
        href={link.href}
        class:list={[{ "site-header__link--current": isCurrentLink(link) }]}
        aria-current={isCurrentLink(link) ? "page" : undefined}
        data-header-link={link.current}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var current = document.documentElement.getAttribute("data-theme") || "light";
      var next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });

    var menuBtn = document.querySelector("[data-mobile-menu-toggle]");
    var menu = document.querySelector("[data-mobile-menu]");
    if (menuBtn && menu) {
      menuBtn.addEventListener("click", function () {
        var open = !menu.hasAttribute("hidden");
        if (open) {
          menu.setAttribute("hidden", "");
          menuBtn.setAttribute("aria-label", "打开导航");
        } else {
          menu.removeAttribute("hidden");
          menuBtn.setAttribute("aria-label", "关闭导航");
        }
      });
    }

    var headerLinks = document.querySelectorAll("[data-header-link]");
    var path = window.location.pathname;
    var currentKey = "";
    if (path.startsWith("/weekly/")) currentKey = "weekly";
    else if (path.startsWith("/docs/")) currentKey = "docs";
    else if (path.startsWith("/about/") || path.startsWith("/contact/")) currentKey = "about";
    if (currentKey) {
      headerLinks.forEach(function (link) {
        var active = link.getAttribute("data-header-link") === currentKey;
        link.classList.toggle("site-header__link--current", active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }
  })();
</script>
