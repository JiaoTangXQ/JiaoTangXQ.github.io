---
type Props = {
  current?: "home" | "about" | "rss";
};
const { current = "home" } = Astro.props;

const links: Array<{ href: string; label: string; key: NonNullable<Props["current"]> }> = [
  { href: "/", label: "归档", key: "home" },
  { href: "/about/", label: "关于", key: "about" },
  { href: "/rss.xml", label: "RSS", key: "rss" },
];

const searchEnabled = import.meta.env.PROD;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="返回首页">
      <span class="site-header__brand-mark">焦糖星球</span>
      <span class="site-header__brand-edition" aria-hidden="true">VOL. I</span>
    </a>
    <nav class="site-header__nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "site-header__link",
            { "site-header__link--current": current === link.key },
          ]}
          aria-current={current === link.key ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      {searchEnabled && (
        <button
          type="button"
          class="site-header__link site-header__search"
          data-search-trigger
          aria-label="打开搜索"
        >
          搜索
        </button>
      )}
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="切换主题"
        title="切换深色 / 浅色主题"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M13.5 9.5A6 6 0 1 1 6.5 2.5a4.8 4.8 0 0 0 7 7Z" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="8" cy="8" r="3" />
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var current = document.documentElement.getAttribute("data-theme") || "light";
      var next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  })();
</script>
