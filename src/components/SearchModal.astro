---
// 搜索模态框：仅生产构建启用（dev 模式 Pagefind 资源不存在）。
// Pagefind 在 build 后扫描 dist/ 生成索引到 dist/pagefind/。
const enabled = import.meta.env.PROD;
---

{
  enabled && (
    <>
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
      <dialog class="search-dialog" data-search-dialog aria-label="搜索文章">
        <div class="search-dialog__inner">
          <button
            class="search-dialog__close"
            type="button"
            data-search-close
            aria-label="关闭搜索"
          >
            ✕
          </button>
          <p class="search-dialog__hint">在所有文章里搜索</p>
          <div id="search" />
        </div>
      </dialog>

      <script is:inline src="/pagefind/pagefind-ui.js" defer />
      <script is:inline>
        (function () {
          var dialog = document.querySelector("[data-search-dialog]");
          if (!dialog) return;

          var triggers = document.querySelectorAll("[data-search-trigger]");
          var closeBtn = dialog.querySelector("[data-search-close]");
          var inited = false;

          function ensureInit() {
            if (inited) return;
            if (typeof window.PagefindUI === "undefined") {
              // pagefind-ui.js 还没加载完，等一帧再试
              window.requestAnimationFrame(ensureInit);
              return;
            }
            new window.PagefindUI({
              element: "#search",
              showSubResults: true,
              showImages: false,
              resetStyles: false,
              translations: {
                placeholder: "搜索焦糖星球的全部文章…",
                clear_search: "清除",
                load_more: "加载更多",
                search_label: "搜索",
                filters_label: "筛选",
                zero_results: "没有匹配「[SEARCH_TERM]」的文章",
                many_results: "找到 [COUNT] 篇匹配「[SEARCH_TERM]」的文章",
                one_result: "找到 1 篇匹配「[SEARCH_TERM]」的文章",
                alt_search:
                  "没有匹配「[SEARCH_TERM]」的文章。展示「[DISPLAY_QUERY]」的结果。",
                search_suggestion: "没有匹配「[SEARCH_TERM]」的文章。试试：",
                searching: "正在搜索「[SEARCH_TERM]」…",
              },
            });
            inited = true;
          }

          function open() {
            ensureInit();
            if (typeof dialog.showModal === "function") {
              dialog.showModal();
            } else {
              dialog.setAttribute("open", "");
            }
            // 短延时聚焦，等 PagefindUI 渲染完
            setTimeout(function () {
              var input = dialog.querySelector(".pagefind-ui__search-input");
              if (input) input.focus();
            }, 50);
          }

          function close() {
            if (typeof dialog.close === "function") {
              dialog.close();
            } else {
              dialog.removeAttribute("open");
            }
          }

          triggers.forEach(function (t) {
            t.addEventListener("click", function (e) {
              e.preventDefault();
              open();
            });
          });

          if (closeBtn) closeBtn.addEventListener("click", close);

          // 点击背景关闭
          dialog.addEventListener("click", function (e) {
            if (e.target === dialog) close();
          });

          // 快捷键：⌘/Ctrl + K 打开
          document.addEventListener("keydown", function (e) {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
              e.preventDefault();
              open();
            }
          });
        })();
      </script>
    </>
  )
}
