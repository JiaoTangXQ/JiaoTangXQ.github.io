---
import { postSummary } from "@/lib/post-view";
import type { Post } from "@/lib/posts";

type Props = {
  posts: Post[];
};

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <aside class="related-posts" aria-label="相关文章">
      <p class="related-posts__eyebrow">
        <span class="related-posts__mark" aria-hidden="true" />
        相关阅读
      </p>
      <ul class="related-posts__list">
        {posts.map((post) => {
          const { url, dateStr, minutes } = postSummary(post);
          return (
            <li class="related-posts__item">
              <a href={url} class="related-posts__link">
                <h3 class="related-posts__title">{post.data.title}</h3>
                {post.data.subtitle && (
                  <p class="related-posts__subtitle">{post.data.subtitle}</p>
                )}
                <p class="related-posts__meta">
                  <time>{dateStr}</time>
                  <span class="related-posts__divider" aria-hidden="true" />
                  <span>{minutes} 分钟</span>
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    </aside>
  )
}

<style>
  .related-posts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
  }

  .related-posts__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-display, serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .related-posts__mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .related-posts__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem 2rem;
  }

  .related-posts__item {
    border-top: 1px solid var(--color-rule-soft);
    padding-top: 1.25rem;
  }

  .related-posts__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .related-posts__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display, serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-ink);
    transition: color 0.15s ease;
  }

  .related-posts__link:hover .related-posts__title {
    color: var(--color-accent-deep);
  }

  .related-posts__subtitle {
    margin: 0 0 0.5rem;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  .related-posts__meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-quiet);
    font-variant-numeric: tabular-nums;
  }

  .related-posts__divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-rule);
  }
</style>
