---
import SearchModal from "@/components/SearchModal.astro";
import { SITE_NAME, type SeoData } from "@/lib/seo";
import "@/styles/global.css";

type Props = {
  seo: SeoData;
};

const { seo } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = seo.canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = seo.ogImage
  ? seo.ogImage.startsWith("http")
    ? seo.ogImage
    : new URL(seo.ogImage, Astro.site).toString()
  : undefined;
const tags = seo.tags ?? [];
const cfBeaconToken = (import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined)?.trim();
const analyticsEnabled = Boolean(import.meta.env.PROD && cfBeaconToken);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = saved || (prefersDark ? "dark" : "light");
        } catch (_) {}
      })();
    </script>

    <link rel="canonical" href={canonical} />
    {seo.noIndex && <meta name="robots" content="noindex, nofollow" />}
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />

    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`${siteUrl}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151515" media="(prefers-color-scheme: dark)" />
    <link rel="me" href="https://x.com/leadbelief" />
    <link rel="me" href="https://github.com/JiaoTangXQ" />

    {seo.jsonLd &&
      (Array.isArray(seo.jsonLd) ? seo.jsonLd : [seo.jsonLd]).map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))}

    {analyticsEnabled && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </head>
  <body>
    <slot />
    <SearchModal />
  </body>
</html>
