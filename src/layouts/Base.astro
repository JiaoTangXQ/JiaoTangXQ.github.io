---
import { Font } from "astro:assets";
import SearchModal from "@/components/SearchModal.astro";
import { SITE_NAME, type SeoData } from "@/lib/seo";
import "@/styles/global.css";

type Props = {
  seo: SeoData;
};

const { seo } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const fullCanonical = seo.canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = seo.ogImage
  ? (seo.ogImage.startsWith("http") ? seo.ogImage : new URL(seo.ogImage, Astro.site).toString())
  : undefined;
const tags = seo.tags ?? [];

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const plausibleHost =
  (import.meta.env.PUBLIC_PLAUSIBLE_HOST as string | undefined) ?? "https://plausible.io";
const analyticsEnabled = Boolean(import.meta.env.PROD && plausibleDomain);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 主题预加载：在 paint 前把 data-theme 设上，避免 FOUC。
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var prefers = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = saved || (prefers ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          /* localStorage blocked — fall back to OS preference via CSS */
        }
      })();
    </script>
    <link rel="canonical" href={fullCanonical} />
    {seo.noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />

    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={fullCanonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`${siteUrl}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />

    {seo.jsonLd &&
      (Array.isArray(seo.jsonLd) ? seo.jsonLd : [seo.jsonLd]).map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))}

    {analyticsEnabled && (
      <script
        is:inline
        defer
        data-domain={plausibleDomain}
        src={`${plausibleHost}/js/script.js`}
      />
    )}
  </head>
  <body>
    <slot />
    <SearchModal />
  </body>
</html>
