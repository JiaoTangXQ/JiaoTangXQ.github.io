---
import Base from "./Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ArticleTOC from "@/components/ArticleTOC.astro";
import { formatDate, isoDate } from "@/lib/format";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

type Props = {
  post: CollectionEntry<"posts">;
  minutes: number;
  headings: MarkdownHeading[];
};

const { post, minutes, headings } = Astro.props;
const { data } = post;
const dateStr = formatDate(data.date, data.lang);
const updatedStr = data.updated ? formatDate(data.updated, data.lang) : null;

const ogImagePath = `/og/${post.id}.png`;
const ogImageAbsolute = new URL(ogImagePath, Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  image: [ogImageAbsolute],
  datePublished: isoDate(data.date),
  dateModified: data.updated ? isoDate(data.updated) : isoDate(data.date),
  author: { "@type": "Person", name: "焦糖" },
  publisher: { "@type": "Organization", name: "焦糖星球" },
  inLanguage: data.lang === "en" ? "en" : "zh-CN",
  keywords: data.tags.join(", "),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(`/posts/${post.id}/`, Astro.site).toString(),
  },
};
---

<Base
  title={`${data.title} — 焦糖星球`}
  description={data.description}
  ogImage={ogImagePath}
  type="article"
  publishedTime={isoDate(data.date)}
  modifiedTime={data.updated ? isoDate(data.updated) : undefined}
  tags={data.tags}
  noIndex={data.draft}
>
  <ReadingProgress />
  <SiteHeader current="home" />
  <ArticleTOC headings={headings} />
  <main class="page page--article">
    <article>
      <header class="article-header">
        <p class="article-eyebrow">
          <time datetime={isoDate(data.date)}>{dateStr}</time>
          {data.tags.length > 0 && (
            <>
              <span class="article-eyebrow__divider" aria-hidden="true"></span>
              {data.tags.map((tag, i) => (
                <>
                  {i > 0 && <span class="article-eyebrow__divider" aria-hidden="true"></span>}
                  <span class="article-eyebrow__tag">#{tag}</span>
                </>
              ))}
            </>
          )}
        </p>
        <h1 class="article-title">{data.title}</h1>
        {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
        <p class="article-meta">
          <span>焦糖</span>
          <span class="article-meta__divider" aria-hidden="true"></span>
          <span>阅读约 {minutes} 分钟</span>
          {updatedStr && (
            <>
              <span class="article-meta__divider" aria-hidden="true"></span>
              <span>更新于 {updatedStr}</span>
            </>
          )}
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <SubscribeForm />
    </article>
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>
