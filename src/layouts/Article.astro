---
import Base from "./Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ArticleTOC from "@/components/ArticleTOC.astro";
import AuthorCard from "@/components/AuthorCard.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import TweetableQuotes from "@/components/TweetableQuotes.astro";
import { seoForPost } from "@/lib/seo";
import { getEntry } from "astro:content";
import type { PostView } from "@/lib/post-view";
import type { Post } from "@/lib/posts";

type Props = {
  view: PostView;
};

const { view } = Astro.props;
const { post, minutes, dateStr, isoDateStr, updatedStr, headings, coverPath, coverAlt } = view;
const { data } = post;
const headerCurrent = post.id.startsWith("weekly/") ? "weekly" : "home";

const seo = seoForPost(view, Astro.site!);

// Resolve frontmatter `related` slugs → published Post entries.
const relatedRaw = data.related.length
  ? await Promise.all(data.related.map((slug) => getEntry("posts", slug)))
  : [];
const relatedPosts: Post[] = relatedRaw.filter(
  (p): p is Post => !!p && !p.data.draft,
);
---

<Base seo={seo}>
  <ReadingProgress />
  <div class="cyberpunk-body">
  <SiteHeader current={headerCurrent} />
  <ArticleTOC headings={headings} />
  <main class="page page--article">
    <article>
      <header class="article-header">
        {coverPath && (
          <figure class="article-cover">
            <img src={coverPath} alt={coverAlt ?? ""} loading="eager" decoding="async" />
            {coverAlt && <figcaption>{coverAlt}</figcaption>}
          </figure>
        )}
        <p class="article-eyebrow">
          <time datetime={isoDateStr}>{dateStr}</time>
          {data.tags.length > 0 && (
            <>
              <span class="article-eyebrow__divider" aria-hidden="true"></span>
              {data.tags.map((tag, i) => (
                <>
                  {i > 0 && <span class="article-eyebrow__divider" aria-hidden="true"></span>}
                  <a class="article-eyebrow__tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
                </>
              ))}
            </>
          )}
        </p>
        <h1 class="article-title">{data.title}</h1>
        {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
        <p class="article-meta">
          <span>焦糖</span>
          <span class="article-meta__divider" aria-hidden="true"></span>
          <span>阅读约 {minutes} 分钟</span>
          {updatedStr && (
            <>
              <span class="article-meta__divider" aria-hidden="true"></span>
              <span>更新于 {updatedStr}</span>
            </>
          )}
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <RelatedPosts posts={relatedPosts} />
      <AuthorCard />
      <SubscribeForm />
    </article>
  </main>
  <SiteFooter />
  <FloatingContact />
  </div>
  <TweetableQuotes />
</Base>

<style>
  .article-cover {
    margin: 0 0 2rem;
  }
  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  .article-cover figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-quiet);
    font-style: italic;
    text-align: center;
  }
</style>
