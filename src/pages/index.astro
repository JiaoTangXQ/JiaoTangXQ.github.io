---
import CyberPage from "@/layouts/CyberPage.astro";
import CyberHero from "@/components/CyberHero.astro";
import DailyCard from "@/components/DailyCard.astro";
import { getPublishedDailies, dailyUrl } from "@/lib/dailies";
import { seoForPage } from "@/lib/seo";

const dailies = await getPublishedDailies();

const seo = seoForPage({
  title: "焦糖星球 — 中文 AI 工程实践写作站",
  description:
    "焦糖星球是中文 AI 工程实践与 AI 信号降噪站。提供 AI 日报、信号归档和面向开发者的技术判断。",
});
---

<CyberPage seo={seo} current="home">
  <div class="cyber-container home-page">
    <CyberHero latestDailyUrl={dailies[0] ? dailyUrl(dailies[0]) : "/docs/"} />

    <section class="cyber-section">
      <div class="cyber-section__head">
        <h2>今日头版</h2>
        <span>Daily Edition</span>
      </div>
      <div class="daily-grid">
        {dailies.slice(0, 6).map((daily) => <DailyCard daily={daily} />)}
      </div>
    </section>

  </div>
</CyberPage>
