---
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "关于 — 焦糖星球",
  description:
    "焦糖星球是关于 AI 时代工程实践的中文写作站。作者焦糖，写 AI 辅助开发、AI Agent 工程、LLM 应用架构、AI 时代的工程文化。",
});
---

<Base seo={seo}>
  <SiteHeader current="about" />
  <main class="page page--about">
    <article class="prose">
      <h1>关于</h1>
      <p class="lede">
        焦糖星球是面向 AI 时代决策者和工程师的中文情报与实践站。
      </p>

      <h2>这个站在写什么</h2>
      <p>
        这里有两条主线：一条是每日 AI 简报，把公开信源压缩成可执行判断；另一条是原创长文，把工程实践讲透。核心主题收在 4 个方向上：
      </p>
      <ul>
        <li><a href="/topics/ai-coding/"><strong>AI 辅助开发</strong></a> — Claude Code、Cursor、subagent 工作流，把 AI 装进真实工程现场。</li>
        <li><a href="/topics/agent/"><strong>AI Agent 工程</strong></a> — tool use、planning、记忆、评估，把 agent 从 demo 推到生产。</li>
        <li><a href="/topics/llm-arch/"><strong>LLM 应用架构</strong></a> — prompt cache、上下文工程、多 model 路由、token 成本。</li>
        <li><a href="/topics/culture/"><strong>AI 时代的工程文化</strong></a> — code review、技术决策、工程师定位的变化。</li>
      </ul>

      <h2>关于作者</h2>
      <p>
        焦糖，工程师。长期关注 AI 工程实践、Agent 工作流、模型应用架构和信息降噪。
      </p>

      <h2>不写什么</h2>
      <ul>
        <li>不转载外部文章。</li>
        <li>不搬运别人已经整理好的结论。</li>
        <li>不写没有来源链路的快讯。</li>
        <li>不写不在上面 4 个主题里的内容。</li>
      </ul>

      <h2>怎么读到新文章</h2>
      <p>
        三种方式，任选其一即可：
      </p>
      <ul>
        <li><strong>邮件订阅</strong> — 站内任意页面底部的订阅框，新文章直接送到信箱（推荐）。</li>
        <li><strong>RSS</strong> — <a href="/rss.xml">/rss.xml</a>，把链接放进你的阅读器。</li>
        <li><strong>X / Twitter</strong> — 关注 <a href="https://x.com/leadbelief" rel="me">@leadbelief</a>，每发一篇会发 thread。</li>
      </ul>

      <h2>联系</h2>
      <ul>
        <li>X · <a href="https://x.com/leadbelief" rel="me">@leadbelief</a></li>
        <li>GitHub · <a href="https://github.com/JiaoTangXQ" rel="me">JiaoTangXQ</a></li>
      </ul>
    </article>
    <SubscribeForm />
  </main>
  <SiteFooter />
</Base>
