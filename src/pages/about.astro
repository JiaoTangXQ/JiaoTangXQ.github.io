---
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "关于 — 焦糖星球",
  description:
    "焦糖星球是面向 AI 时代决策者和工程师的中文情报站。作者焦糖，关注 AI 产品、研究、开源、资本和工程信号。",
});
---

<Base seo={seo}>
  <SiteHeader current="about" />
  <main class="page page--about">
    <article class="prose">
      <h1>关于</h1>
      <p class="lede">
        焦糖星球是面向 AI 时代决策者和工程师的中文情报与实践站。
      </p>

      <h2>这个站在写什么</h2>
      <p>
        这里专注每日 AI 情报：从公开信源、产品更新、研究论文、开源项目和行业动态里筛出值得普通读者与工程团队关注的信号。
      </p>
      <ul>
        <li><a href="/docs/"><strong>AI 日报</strong></a> — 每日整理产品、研究、开源和商业化信号。</li>
        <li><a href="/weekly/"><strong>AI 周报</strong></a> — 从一周日报里提炼更高层的趋势判断。</li>
        <li><strong>来源链路</strong> — 关键条目尽量保留原始来源，方便继续追踪。</li>
      </ul>

      <h2>关于作者</h2>
      <p>
        焦糖，工程师。长期关注 AI 工程实践、Agent 工作流、模型应用架构和信息降噪。
      </p>

      <h2>不写什么</h2>
      <ul>
        <li>不转载外部文章。</li>
        <li>不搬运别人已经整理好的结论。</li>
        <li>不写没有来源链路的快讯。</li>
        <li>不把低价值发布包装成重大新闻。</li>
      </ul>

      <h2>怎么读到更新</h2>
      <p>
        三种方式，任选其一即可：
      </p>
      <ul>
        <li><strong>邮件订阅</strong> — 站内任意页面底部的订阅框，重要更新直接送到信箱（推荐）。</li>
        <li><strong>RSS</strong> — <a href="/rss.xml">/rss.xml</a>，把链接放进你的阅读器。</li>
        <li><strong>X / Twitter</strong> — 关注 <a href="https://x.com/leadbelief" rel="me">@leadbelief</a>。</li>
      </ul>

      <h2>联系</h2>
      <ul>
        <li>X · <a href="https://x.com/leadbelief" rel="me">@leadbelief</a></li>
        <li>GitHub · <a href="https://github.com/JiaoTangXQ" rel="me">JiaoTangXQ</a></li>
      </ul>
    </article>
    <SubscribeForm />
  </main>
  <SiteFooter />
</Base>
