---
const githubProfileUrl = "https://github.com/JiaoTangXQ";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="跳转到焦糖的 GitHub 个人主页。" />
    <meta http-equiv="refresh" content={`0;url=${githubProfileUrl}`} />
    <link rel="canonical" href={githubProfileUrl} />
    <title>跳转到 GitHub</title>
    <script define:vars={{ githubProfileUrl }} is:inline>
      window.location.replace(githubProfileUrl);
    </script>
  </head>
  <body>
    <p>
      正在跳转到 <a href={githubProfileUrl} rel="me">GitHub 个人主页</a>。
    </p>
  </body>
</html>
