---
import CyberPage from "@/layouts/CyberPage.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "价格说明 — 焦糖星球",
  description: "焦糖星球的价格说明：当前公开内容免费阅读，RSS 和日报归档免费开放。",
});
---

<CyberPage seo={seo}>
  <main class="legal-page cyber-container cyber-container--narrow">
    <article class="legal-card cp-cut prose">
      <p class="cyber-eyebrow">Access</p>
      <h1>价格说明</h1>
      <p class="lede">
        焦糖星球当前没有付费账户、会员墙或订阅商品。公开文章、AI 日报归档和 RSS 都可以免费阅读。
      </p>

      <h2>当前价格</h2>
      <p>
        公开内容：免费。RSS：免费。站内搜索：免费。未来如果出现付费产品，会在购买前明确展示价格、交付内容和退款规则。
      </p>

      <h2>为什么保留这个页面</h2>
      <p>
        参考站包含价格页这一类功能路由。焦糖星球保留同等入口，但把内容改成个人站的真实状态，不伪装成不存在的 SaaS 服务。
      </p>
    </article>
  </main>
</CyberPage>
