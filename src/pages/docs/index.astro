---
import CyberPage from "@/layouts/CyberPage.astro";
import DailyCard from "@/components/DailyCard.astro";
import { getPublishedDailies, groupDailiesByMonth } from "@/lib/dailies";
import { seoForPage } from "@/lib/seo";

const dailies = await getPublishedDailies();
const groups = groupDailiesByMonth(dailies);

const seo = seoForPage({
  title: "AI Daily | AI日报 — 焦糖星球",
  description: "焦糖星球 AI 日报中心：每日 AI 行业动态、前沿技术、开源项目和工程影响判断。",
});
---

<CyberPage seo={seo} current="docs">
  <div class="cyber-container">
    <header class="docs-header">
      <span>Daily Edition</span>
      <h1>AI 日报</h1>
      <p>每日 AI 行业动态、前沿技术、开源项目与工程影响判断，按头版逻辑归档。</p>
    </header>
    {groups.map((group) => (
      <section class="daily-month">
        <div class="daily-month__head">
          <h2>{group.month.replace("-", " ")}</h2>
        </div>
        <div class="daily-grid">
          {group.dailies.map((daily) => <DailyCard daily={daily} />)}
        </div>
      </section>
    ))}
  </div>
</CyberPage>
