---
import CyberPage from "@/layouts/CyberPage.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "隐私说明 — 焦糖星球",
  description: "焦糖星球的隐私说明：说明站点分析、订阅、外部链接和日志数据如何处理。",
});
---

<CyberPage seo={seo}>
  <main class="legal-page cyber-container cyber-container--narrow">
    <article class="legal-card cp-cut prose">
      <p class="cyber-eyebrow">Privacy</p>
      <h1>隐私说明</h1>
      <p class="lede">
        焦糖星球是个人内容站。这里说明站点如何处理访问日志、搜索、订阅和外部链接。
      </p>

      <h2>访问分析</h2>
      <p>
        站点可能使用 Cloudflare Web Analytics 了解页面访问量和基础性能。该分析不依赖第三方广告 cookie，也不用于跨站追踪。
      </p>

      <h2>搜索与订阅</h2>
      <p>
        站内搜索由静态索引提供，搜索词只在浏览器内用于查询索引。邮件订阅如果启用，会交给 Buttondown 处理，你提交的邮箱只用于发送站点更新。
      </p>

      <h2>外部来源</h2>
      <p>
        AI 日报会链接到公开原始来源。点击外部链接后，对方网站的隐私政策和日志策略由该网站负责。
      </p>

      <h2>联系</h2>
      <p>
        如需删除订阅信息，使用邮件里的退订链接即可。其他隐私相关问题可以通过 <a href="https://github.com/JiaoTangXQ">GitHub</a> 联系。
      </p>
    </article>
  </main>
</CyberPage>
