---
import CyberPage from "@/layouts/CyberPage.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "使用条款 — 焦糖星球",
  description: "焦糖星球的使用条款：说明内容性质、引用边界、外部链接和责任限制。",
});
---

<CyberPage seo={seo}>
  <main class="legal-page cyber-container cyber-container--narrow">
    <article class="legal-card cp-cut prose">
      <p class="cyber-eyebrow">Terms</p>
      <h1>使用条款</h1>
      <p class="lede">
        使用焦糖星球，即表示你理解这里的内容是个人观察、工程记录和信息整理，不构成法律、投资或商业建议。
      </p>

      <h2>内容边界</h2>
      <p>
        博客文章是原创写作。AI 日报会基于公开原始来源整理信号，并保留来源链接；标题和摘要会重新组织，不复刻其他站点的整理文本。
      </p>

      <h2>引用与转载</h2>
      <p>
        可以引用少量文字并附上原文链接。完整转载、批量镜像或把内容重新包装为自己的资料库，请先取得许可。
      </p>

      <h2>外部链接</h2>
      <p>
        站点会链接到新闻、论文、工具和平台页面。外部页面的可用性、准确性和后续变更不由焦糖星球控制。
      </p>

      <h2>变更</h2>
      <p>
        条款可能随站点功能调整而更新。继续使用站点即表示接受更新后的说明。
      </p>
    </article>
  </main>
</CyberPage>
