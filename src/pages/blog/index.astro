---
import CyberPage from "@/layouts/CyberPage.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/lib/posts";
import { allPostTags, BLOG_CATEGORIES, postCategories, type BlogCategory } from "@/lib/categories";
import { seoForPage } from "@/lib/seo";

const posts = await getPublishedPosts();
const tags = allPostTags(posts);
const selectedCategory = (Astro.url.searchParams.get("category") ?? "root") as BlogCategory;
const selectedTag = Astro.url.searchParams.get("tag") ?? "";
const categoryEntries = Object.entries(BLOG_CATEGORIES) as Array<[BlogCategory, { label: string }]>;
const headerCurrent = selectedCategory === "weekly" ? "weekly" : "home";

const seo = seoForPage({
  title: "博客 — 焦糖星球",
  description: "焦糖星球的原创文章、AI 工程实践长文和周报归档。",
});
---

<CyberPage seo={seo} current={headerCurrent}>
  <div class="cyber-container cyber-container--narrow">
    <header class="archive-header">
      <div>
        <h1>社论与长文</h1>
        <p>原创长文、周度判断与工程实践观察，按专栏方式归档。</p>
      </div>
      <a class="rss-button" href="/rss.xml">RSS</a>
    </header>

    <section class="archive-panel cp-cut">
      <p class="archive-panel__stamp">Archive</p>
      <div class="filter-group">
        <span>栏目</span>
        {categoryEntries.map(([key, meta]) => (
          <a class:list={[{ "is-active": selectedCategory === key }]} href={key === "root" ? "/blog/" : `/blog/?category=${key}`}>
            {meta.label}
          </a>
        ))}
      </div>
      <div class="filter-group filter-group--tags">
        <span>标签</span>
        <a class:list={[{ "is-active": !selectedTag }]} href={`/blog/${selectedCategory !== "root" ? `?category=${selectedCategory}` : ""}`}>全部</a>
        {tags.map((tag) => (
          <a class:list={[{ "is-active": selectedTag === tag }]} href={`/blog/?${new URLSearchParams({ ...(selectedCategory !== "root" ? { category: selectedCategory } : {}), tag }).toString()}`}>
            {tag}
          </a>
        ))}
      </div>
      <div class="post-grid" data-blog-grid>
        {posts.map((post) => {
          const categories = postCategories(post);
          return (
            <div data-categories={categories.join(",")} data-tags={post.data.tags.join(",")}>
              <PostCard post={post} />
            </div>
          );
        })}
      </div>
    </section>
  </div>
</CyberPage>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var category = params.get("category") || "root";
    var tag = params.get("tag") || "";
    var cards = document.querySelectorAll("[data-blog-grid] > [data-categories]");
    cards.forEach(function (card) {
      var categories = (card.getAttribute("data-categories") || "").split(",");
      var tags = (card.getAttribute("data-tags") || "").split(",");
      var visible = (category === "root" || categories.includes(category)) && (!tag || tags.includes(tag));
      card.toggleAttribute("hidden", !visible);
    });
  })();
</script>
