---
import Base from "@/layouts/Base.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "联系 — 焦糖星球",
  description: "焦糖星球的公开联系入口。",
});
---

<Base seo={seo}>
  <SiteHeader />
  <main class="site-main page-shell">
    <article class="prose">
      <p class="eyebrow">Contact</p>
      <h1>联系</h1>
      <ul>
        <li>X：<a href="https://x.com/leadbelief" rel="me">@leadbelief</a></li>
        <li>GitHub：<a href="https://github.com/JiaoTangXQ" rel="me">JiaoTangXQ</a></li>
        <li>RSS：<a href="/rss.xml">/rss.xml</a></li>
      </ul>
    </article>
  </main>
  <SiteFooter />
</Base>
