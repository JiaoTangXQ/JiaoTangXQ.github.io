---
import CyberPage from "@/layouts/CyberPage.astro";
import { seoForPage } from "@/lib/seo";

const seo = seoForPage({
  title: "Refund Policy — 焦糖星球",
  description: "焦糖星球的退款说明：当前没有付费产品，未来如有购买项会单独列出退款规则。",
});
---

<CyberPage seo={seo}>
  <main class="legal-page cyber-container cyber-container--narrow">
    <article class="legal-card cp-cut prose">
      <p class="cyber-eyebrow">Refund</p>
      <h1>退款说明</h1>
      <p class="lede">
        焦糖星球当前没有付费产品，因此没有需要执行的退款流程。
      </p>

      <h2>未来付费内容</h2>
      <p>
        如果未来上线课程、资料包、会员或咨询服务，购买页面会提前说明价格、交付范围、退款窗口和不适用退款的场景。
      </p>

      <h2>误付款</h2>
      <p>
        如果通过第三方平台发生误付款，请优先按该平台的订单和退款流程处理，并通过 <a href="/contact/">联系页</a> 补充说明。
      </p>
    </article>
  </main>
</CyberPage>
