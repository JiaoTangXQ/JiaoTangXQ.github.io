---
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";
import { getPublishedPosts } from "@/lib/posts";
import { seoForPage, SITE_NAME } from "@/lib/seo";
import { HUB_PILLARS, PILLARS, type PillarSlug } from "@/lib/pillars";

export async function getStaticPaths() {
  return HUB_PILLARS.map((slug) => ({ params: { pillar: slug } }));
}

const { pillar } = Astro.params as { pillar: PillarSlug };
const meta = PILLARS[pillar];

const allPosts = await getPublishedPosts();
const posts = allPosts.filter((p) => p.data.pillar === pillar);

const seo = seoForPage({
  title: `${meta.title} — ${SITE_NAME}`,
  description: meta.seoDescription,
  ogImage: `/og/topic/${pillar}.png`,
});
---

<Base seo={seo}>
  <SiteHeader />
  <main class="page page--home">
    <section class="masthead">
      <p class="masthead__edition">
        <span class="masthead__edition-mark" aria-hidden="true"></span>
        TOPIC · 主题
      </p>
      <h1 class="masthead__title">{meta.title}</h1>
      <p class="masthead__lede">{meta.intro}</p>
    </section>

    {posts.length === 0 ? (
      <section class="empty">
        <p class="empty__title">这个主题第一篇正在动笔。</p>
        <p class="empty__body">
          订阅 <a href="/rss.xml">RSS</a> 或 <a href="#subscribe">邮件 newsletter</a>，第一篇上线时会送到你的阅读器或邮箱。
        </p>
      </section>
    ) : (
      <section class="post-list" aria-label={`${meta.title} 文章列表`}>
        <p class="post-list__index-label">{meta.lede}</p>
        {posts.map((post) => <PostCard post={post} />)}
      </section>
    )}

    <div id="subscribe">
      <SubscribeForm
        title={`订阅「${meta.title}」更新`}
        lede="新文章上线时直接送到你的邮箱。每发一篇邮箱响一次，不发别的。"
      />
    </div>
  </main>
  <SiteFooter />
</Base>
