# 数据分析（Plausible）
# 注册 https://plausible.io 后填入域名（同 Plausible dashboard 里的 site name）。
# 留空则不注入分析脚本。
# PUBLIC_PLAUSIBLE_DOMAIN=jiaotangxq.github.io
# 可选：自部署 Plausible 时改这个，默认 https://plausible.io
# PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# 邮件订阅（Buttondown）
# 注册 https://buttondown.com 后填入用户名（profile slug）。
# 留空则订阅表单显示禁用占位文案。
# PUBLIC_BUTTONDOWN_USERNAME=jiaotangxq

# 内容生产线（content-agent）
# 不设置 OPENAI_API_KEY 时会使用本地规则改写，适合调试；正式生产建议启用远程模型。
# OPENAI_API_KEY=sk-...
# CONTENT_AGENT_MODEL=gpt-5.4
# CONTENT_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# CONTENT_AGENT_REASONING_EFFORT=low

# 可选：启用 AI Search 信源。需要 OPENAI_API_KEY。
# CONTENT_AGENT_AI_SEARCH=true

# 可选：RSSHub 桥接源。默认使用 https://rsshub.app；生产建议换成自部署实例。
# 用来补 X/Twitter、微信公众号、B站、YouTube 等非稳定 RSS 信源。
# CONTENT_AGENT_RSSHUB_BASE=https://rsshub.app

# 可选：补充微信公众号 RSSHub 路由。多个路由用英文逗号分隔。
# 示例：/wechat/mp/your-route-1,/wechat/mp/your-route-2
# CONTENT_AGENT_WECHAT_RSSHUB_ROUTES=

# 可选：补充视频源 RSSHub 路由。多个路由用英文逗号分隔。
# 示例：/youtube/channel/CHANNEL_ID,/bilibili/user/video/UID
# CONTENT_AGENT_VIDEO_RSSHUB_ROUTES=

# 可选：GitHub Search 提高 rate limit。没有 token 也能跑，但更容易遇到公共限额。
# CONTENT_AGENT_GITHUB_TOKEN=ghp_...

# 可选：Anthropic 当前没有稳定公开 RSS，默认关闭旧 RSS 探测。
# CONTENT_AGENT_ANTHROPIC_RSS=true

# 可选：接入 Folo 列表。多个 list id 用英文逗号分隔。
# FOLO_DATA_API=https://api.follow.is/entries
# FOLO_COOKIE=
# FOLO_LIST_IDS=
